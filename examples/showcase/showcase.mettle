// A small tour of what MythicUI can do today: layout, cards, buttons, toggles,
// sliders, progress, text inputs, the clipboard, scroll views, a 100,000 row list,
// icons, keyboard focus (press Tab) and light/dark themes.
import "mythic/mythic";

struct App {
  dark: bool;
  mode: int32;          // 0 debug, 1 release, 2 profile
  threads: float32;
  optimize: bool;
  warnings: bool;
  strip: bool;
  notify: bool;
  autosave: bool;
  building: bool;
  progress: float32;
  builds: int32;
  name: MythicTextBuf;
  version: MythicTextBuf;
  output: MythicTextBuf;
  status: int32;        // 0 none, 1 saved, 2 copied
  file: int64;          // selected row in the file list, -1 for none
  first: int64;         // rows the file list builds this frame
  last: int64;
}

const FILE_COUNT: int64 = 100000;

// Log lines so far: 40 per finished build, plus the share of the running one.
fn log_lines(app: App*) -> int32 {
  var n: int32 = app->builds * 40;
  if (app->building) { n = n + (int32)(app->progress * 40.0); }
  return n;
}

// "1", "1.2" or "1.2.3": digits separated by single dots.
fn version_ok(b: MythicTextBuf*) -> bool {
  var s: string = mythic_textbuf_str(b);
  var n: int64 = (int64)s.length;
  if (n == 0) { return false; }
  var digit: bool = false;
  for i: int64 in 0..n {
    var c: int32 = (int32)(uint8)s.chars[i];
    if (c >= 48 && c <= 57) {
      digit = true;
    } else if (c == 46 && digit) {
      digit = false;
    } else {
      return false;
    }
  }
  return digit;
}

fn update_output(app: App*) {
  var name: string = mythic_textbuf_str(&app->name);
  if (name.length == 0) { name = "app"; }
  mythic_textbuf_set(&app->output, "build/release/{name}");
}

fn header(ui: MythicUi*, app: App*) {
  mythic_row_begin(ui, { width: mythic_grow(), align_y: MYTHIC_ALIGN_CENTER, gap: 12 });
    mythic_column_begin(ui, { gap: 2 });
      mythic_label_ex(ui, "MythicUI", { role: MYTHIC_TYPE_HEADING });
      mythic_label_ex(ui, "Immediate-mode GUI for Mettle. Press Tab to move around.", { role: MYTHIC_TYPE_BODY, tone: MYTHIC_TONE_SECONDARY });
    mythic_end(ui);
    mythic_spacer(ui);
    if (mythic_switch(ui, "Dark mode", &app->dark)) {
      if (app->dark) { mythic_set_theme(ui, mythic_theme_dark()); } else { mythic_set_theme(ui, mythic_theme_light()); }
    }
  mythic_end(ui);
}

fn build_card(ui: MythicUi*, app: App*) {
  mythic_card_begin_ex(ui, { width: mythic_fixed(340), pad: mythic_pad(20), gap: 14 }, { elevation: 1 });
    mythic_label_ex(ui, "Build", { role: MYTHIC_TYPE_TITLE });
    mythic_label_ex(ui, "Profile", { role: MYTHIC_TYPE_LABEL, tone: MYTHIC_TONE_SECONDARY });
    mythic_row_begin(ui, { gap: 16 });
      mythic_radio(ui, "Debug", &app->mode, 0);
      mythic_radio(ui, "Release", &app->mode, 1);
      mythic_radio(ui, "Profile", &app->mode, 2);
    mythic_end(ui);
    mythic_checkbox(ui, "Optimize", &app->optimize);
    mythic_checkbox(ui, "Treat warnings as errors", &app->warnings);
    mythic_checkbox(ui, "Strip symbols", &app->strip);
    mythic_separator(ui);
    if (app->building) {
      mythic_progress_ex(ui, "Compiling", app->progress, { width: mythic_grow() });
    } else if (app->builds > 0) {
      mythic_progress_ex(ui, "Build finished", 1.0, { width: mythic_grow(), color: mythic_theme(ui)->colors.success });
    } else {
      mythic_progress_ex(ui, "Ready", 0.0, { width: mythic_grow() });
    }
    mythic_row_begin(ui, { gap: 8 });
      mythic_disabled_begin(ui, app->building);
        if (mythic_button_ex(ui, "Build", { variant: MYTHIC_BTN_PRIMARY, icon: MYTHIC_ICON_ARROW_RIGHT })) {
          app->building = true;
          app->progress = 0.0;
        }
      mythic_disabled_end(ui);
      if (mythic_button(ui, "Clean")) { app->builds = 0; app->progress = 0.0; }
      mythic_button_ex(ui, "Logs", { variant: MYTHIC_BTN_GHOST });
    mythic_end(ui);
  mythic_end(ui);
}

fn settings_card(ui: MythicUi*, app: App*) {
  mythic_card_begin_ex(ui, { width: mythic_grow(), pad: mythic_pad(20), gap: 14 }, { elevation: 1 });
    mythic_label_ex(ui, "Settings", { role: MYTHIC_TYPE_TITLE });
    mythic_slider_ex(ui, "CPU budget", &app->threads, { min: 0.0, max: 1.0, step: 0.05, width: mythic_grow() });
    mythic_switch(ui, "Desktop notifications", &app->notify);
    mythic_switch(ui, "Save on build", &app->autosave);
    mythic_separator(ui);
    mythic_label_ex(ui, "Everything here is drawn by MythicUI itself on the CPU: rounded corners, soft shadows, icons and Inter text, with no toolkit underneath.", { role: MYTHIC_TYPE_BODY, tone: MYTHIC_TONE_SECONDARY, wrap: true, width: mythic_grow() });
    mythic_row_begin(ui, { gap: 10, align_y: MYTHIC_ALIGN_CENTER });
      var c: uint32 = mythic_theme(ui)->colors.text_secondary;
      mythic_icon(ui, MYTHIC_ICON_CHECK, 16.0, c);
      mythic_icon(ui, MYTHIC_ICON_SEARCH, 16.0, c);
      mythic_icon(ui, MYTHIC_ICON_INFO, 16.0, c);
      mythic_icon(ui, MYTHIC_ICON_WARNING, 16.0, c);
      mythic_icon(ui, MYTHIC_ICON_PLUS, 16.0, c);
      mythic_icon(ui, MYTHIC_ICON_CLOSE, 16.0, c);
      mythic_icon(ui, MYTHIC_ICON_MENU, 16.0, c);
    mythic_end(ui);
  mythic_end(ui);
}

fn project_card(ui: MythicUi*, app: App*) {
  mythic_card_begin_ex(ui, { width: mythic_grow(), pad: mythic_pad(20), gap: 14 }, { elevation: 1 });
    mythic_label_ex(ui, "Project", { role: MYTHIC_TYPE_TITLE });
    mythic_row_begin(ui, { width: mythic_grow(), gap: 16 });
      if (mythic_text_input_ex(ui, "Name", &app->name, { placeholder: "my-app", width: mythic_grow() })) {
        update_output(app);
        app->status = 0;
      }
      if (mythic_last(ui).submitted) { app->status = 1; }
      var bad: bool = !version_ok(&app->version);
      mythic_text_input_ex(ui, "Version", &app->version, { placeholder: "1.0.0", width: mythic_fixed(160), error: bad });
    mythic_end(ui);
    mythic_row_begin(ui, { width: mythic_grow(), gap: 8, align_y: MYTHIC_ALIGN_END });
      mythic_text_input_ex(ui, "Output", &app->output, { icon: MYTHIC_ICON_ARROW_RIGHT, width: mythic_grow(), read_only: true });
      if (mythic_button(ui, "Copy path")) {
        mythic_clipboard_set(ui, mythic_textbuf_str(&app->output));
        app->status = 2;
      }
    mythic_end(ui);
    if (app->status == 1) {
      mythic_label_ex(ui, "Saved.", { role: MYTHIC_TYPE_BODY, tone: MYTHIC_TONE_SECONDARY });
    } else if (app->status == 2) {
      mythic_label_ex(ui, "Output path copied. Paste it anywhere, or into the name field with Ctrl+V.", { role: MYTHIC_TYPE_BODY, tone: MYTHIC_TONE_SECONDARY });
    } else {
      mythic_label_ex(ui, "Enter saves the name. Ctrl+Z undoes, and copy and paste work with other apps.", { role: MYTHIC_TYPE_BODY, tone: MYTHIC_TONE_SECONDARY });
    }
  mythic_end(ui);
}

fn files_card(ui: MythicUi*, app: App*) {
  mythic_card_begin_ex(ui, { width: mythic_grow(), pad: mythic_pad(20), gap: 14 }, { elevation: 1 });
    mythic_label_ex(ui, "Files", { role: MYTHIC_TYPE_TITLE });
    mythic_list_begin(ui, "files", { width: mythic_grow(), height: mythic_fixed(260) });
      mythic_list_visible_range(ui, 32, FILE_COUNT, &app->first, &app->last);
      for i: int64 in app->first..app->last {
        mythic_push_id_int(ui, i);
        if (mythic_list_item(ui, "src/module_{i}.mettle", i == app->file)) { app->file = i; }
        mythic_pop_id(ui);
      }
    mythic_end(ui);
    if (app->file < 0) {
      mythic_label_ex(ui, "100,000 rows, and only the ones on screen get built.", { role: MYTHIC_TYPE_BODY, tone: MYTHIC_TONE_SECONDARY });
    } else {
      mythic_label_ex(ui, "Selected src/module_{app->file}.mettle", { role: MYTHIC_TYPE_BODY, tone: MYTHIC_TONE_SECONDARY });
    }
  mythic_end(ui);
}

fn log_card(ui: MythicUi*, app: App*) {
  mythic_card_begin_ex(ui, { width: mythic_grow(), pad: mythic_pad(20), gap: 14 }, { elevation: 1 });
    mythic_label_ex(ui, "Log", { role: MYTHIC_TYPE_TITLE });
    mythic_scroll_begin(ui, "log", { width: mythic_grow(), height: mythic_fixed(260), gap: 4 });
      var n: int32 = log_lines(app);
      if (n == 0) {
        mythic_label_ex(ui, "Press Build to fill the log.", { role: MYTHIC_TYPE_BODY, tone: MYTHIC_TONE_SECONDARY });
      }
      for i: int32 in 0..n {
        mythic_label_ex(ui, "compiling src/module_{i}.mettle", { role: MYTHIC_TYPE_MONO });
      }
    mythic_end(ui);
    mythic_label_ex(ui, "{log_lines(app)} lines", { role: MYTHIC_TYPE_BODY, tone: MYTHIC_TONE_SECONDARY });
  mythic_end(ui);
}

fn frame(ui: MythicUi*, ud: rawptr) {
  var app: App* = (App*)ud;
  if (app->building) {
    app->progress = app->progress + mythic_dt(ui) * 0.35;
    if (app->progress >= 1.0) { app->building = false; app->builds = app->builds + 1; }
    mythic_request_frame_in(ui, 16);
  }
  mythic_scroll_begin(ui, "page", { width: mythic_grow(), height: mythic_grow(), pad: mythic_pad(32), gap: 24 });
    header(ui, app);
    mythic_row_begin(ui, { width: mythic_grow(), gap: 20 });
      build_card(ui, app);
      settings_card(ui, app);
    mythic_end(ui);
    project_card(ui, app);
    mythic_row_begin(ui, { width: mythic_grow(), gap: 20 });
      files_card(ui, app);
      log_card(ui, app);
    mythic_end(ui);
  mythic_end(ui);
}

fn main() -> int32 {
  var app: App;
  app.mode = 1;
  app.threads = 0.6;
  app.optimize = true;
  app.notify = true;
  app.file = -1;
  app.name.max_len = 40;
  mythic_textbuf_set(&app.name, "mythic-demo");
  mythic_textbuf_set(&app.version, "0.3.0");
  update_output(&app);
  var rc: int32 = mythic_run({ title: "MythicUI showcase", width: 860, height: 760 }, &frame, (rawptr)&app);
  mythic_textbuf_free(&app.name);
  mythic_textbuf_free(&app.version);
  mythic_textbuf_free(&app.output);
  return rc;
}
